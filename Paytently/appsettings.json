{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kafka": {
    "Broker": "kafka:9092",
    "RequestTopic": "payment-requests",
    "ResponseTopic": "payment-responses",
    "ResponseTimeoutSeconds": 2
  }
}
